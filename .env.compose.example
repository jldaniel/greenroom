# Host interface ports are published on. Loopback by default; set to 0.0.0.0
# (or a specific LAN address) to expose Greenroom beyond this machine.
GREENROOM_PUBLISH_HOST=127.0.0.1

# Ports published to the host.
GREENROOM_API_HOST_PORT=49331
GREENROOM_WEB_HOST_PORT=5173
GREENROOM_MCP_HOST_PORT=49332

# Default: a named Docker volume. To reuse an existing SQLite DB, point this at
# the directory containing the file and set GREENROOM_DB_FILENAME to that file.
GREENROOM_DATA_VOLUME=greenroom-data
GREENROOM_DB_FILENAME=greenroom.sqlite

# Host directory mounted at /worktrees for repositories you want Greenroom to read.
GREENROOM_WORKTREE_VOLUME=.

# Unauthenticated first-token bootstrap endpoint. "enabled" is safe with the
# loopback publish default above; set to "disabled" and provide
# GREENROOM_BOOTSTRAP_ADMIN_TOKEN when exposing Greenroom beyond loopback.
GREENROOM_SETUP_TOKEN_ENDPOINT=enabled

# Optional admin token registered at startup (min 24 chars). Required to
# bootstrap auth when the setup-token endpoint is disabled.
GREENROOM_BOOTSTRAP_ADMIN_TOKEN=

# Optional fallback token for MCP clients that cannot send Authorization headers.
GREENROOM_API_TOKEN=

# Optional host-side coding harness bridge used by harness profiles.
# To use host Claude Code through the bridge:
# 1. Set GREENROOM_HARNESS_TOKEN to a local random token.
# 2. Start the host bridge with the same token:
#    GREENROOM_HARNESS_KIND=claude-code bun run harness:dev
# 3. Start Compose with GREENROOM_HARNESS_BASE_URL pointing at host.docker.internal.
GREENROOM_HARNESS_BASE_URL=
GREENROOM_HARNESS_TOKEN=
GREENROOM_HARNESS_TIMEOUT_MS=180000

# Optional fresh-DB profile seed override: mock, or harness:<kind> (for
# example harness:claude-code). Leave empty to seed from harness detection:
# detected CLIs get harness profiles; with no reachable bridge the container
# seeds mock profiles whose description explains how to switch to a harness.
# All AI runs go through the harness bridge configured above.
GREENROOM_DEFAULT_AI_BACKEND=
